# OpenCode Go subscription (metered key — never exposed to the client).
OPENCODE_API_KEY=
# e.g. https://opencode.ai/zen/go/v1 — verified against the live API 2026-09-02.
OPENCODE_BASE_URL=
# CSV of bare model ids, e.g. "glm-5.3,qwen-3.5". Empty = /api/models serves
# only the cached upstream list.
OPENCODE_MODELS=

# Google OAuth (secrets).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# express-session signing secret (secret).
SESSION_SECRET=

# Local dev runs through Angular's port-4200 proxy. The callback is
# APP_ORIGIN + /auth/google/callback.
# No trailing slash.
APP_ORIGIN=http://localhost:4200

# CSV of full email addresses, case-insensitive exact match.
ALLOWED_EMAILS=

# postgresql://<user>:<password>@db:5432/<database>
# Dev: postgresql://app:app@localhost:5432/appdb
# Cluster overrides only the host to `db` via a Secret — app code never
# branches on environment.
DATABASE_URL=postgresql://app:app@localhost:5432/appdb

# Per-user daily message cap. With tools on, one message costs up to 4
# upstream calls — see WEB_SEARCH_ENABLED below.
DAILY_MESSAGE_LIMIT=200

# bool, default true; set to false only for local http.
COOKIE_SECURE=false

# Fixed at 3000 by convention.
PORT=3000

# Wave 1.5 — model-driven web_search/web_fetch tools.
# bool, default false in code; on here and in the chart. Off = pre-Wave-1.5
# behaviour exactly, no `tools` sent. Local dev pairs it with the SearXNG
# service in docker-compose.dev.yml — start that too, or searches fail.
WEB_SEARCH_ENABLED=true
# 'searxng' | 'brave', default 'searxng'. Unknown value fails at boot.
SEARCH_PROVIDER=searxng
# e.g. http://localhost:8080 — required when SEARCH_PROVIDER=searxng. No
# trailing slash. Local dev: docker-compose.dev.yml's searxng service.
SEARXNG_BASE_URL=http://localhost:8080
# Secret; required when SEARCH_PROVIDER=brave, unused otherwise.
BRAVE_SEARCH_API_KEY=
# CSV of model ids allowed to receive a `tools` array. Each one here was
# live-probed against the real OpenCode API and confirmed to honor `tools`
# and actually call the function (2026-09-02). An id not in this list
# streams with no `tools` sent and no chips, rather than risk a silent
# no-op tool call against an unverified model.
TOOL_CAPABLE_MODELS=glm-5.3,glm-5.3-flash,glm-5,deepseek-v4-flash,qwen3.8-flash,kimi-k2.7-code,mimo-v2.5
