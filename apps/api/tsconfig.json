{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "paths": {
      "@contracts": ["../../libs/contracts/dist/index"],
      "@contracts/*": ["../../libs/contracts/dist/*"]
    },
    // Deliberately no "incremental": true — its .tsbuildinfo cache goes
    // stale whenever dist/ is deleted out-of-band (e.g. nest-cli's
    // deleteOutDir, or a manual clean), which silently produces
    // incomplete/empty builds. Not worth the footgun at this project size.
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false
  },
  "exclude": ["node_modules", "test", "dist"]
}
